{
  "name": "airdrop-local",
  "version": "1.0.0",
  "description": "Cross-platform bidirectional local Wi-Fi file and text transfer web app (Neo-Brutalist / Electric Pop Kinetic UI)",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "prestart": "npm run build",
    "start": "node server/index.js",
    "serve": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\""
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.460.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.1"
  },
  "keywords": [
    "airdrop",
    "file-transfer",
    "local-wifi",
    "cross-platform",
    "neo-brutalist",
    "kinetic-ui",
    "zero-install"
  ],
  "author": "DropPop Team",
  "license": "MIT"
}
